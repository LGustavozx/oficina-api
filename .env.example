# Copie para .env e ajuste. O docker-compose já tem padrões, então o .env é opcional.
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_DB=oficina
HTTP_PORT=8080

# Mínimo de 32 caracteres. Gere um valor aleatório fora do desenvolvimento local.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_TTL=1h

# Administrador criado na primeira execução, se ainda não houver usuários.
ADMIN_EMAIL=admin@oficina.local
ADMIN_PASSWORD=troque-esta-senha
